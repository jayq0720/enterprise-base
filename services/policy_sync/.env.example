# X5 制度同步服务配置。真实值放服务器密钥文件，不进仓库。
# Frappe Webhook 上填的 Secret（两边一致，至少 32 位）
EB_SYNC_WEBHOOK_SECRET=
# 手动触发 POST /v1/reconcile 时带的 Token（至少 32 位）
EB_SYNC_SERVICE_TOKEN=
EB_FRAPPE_URL=http://frappe:8000
EB_FRAPPE_API_KEY=
EB_FRAPPE_API_SECRET=
EB_FRAPPE_BINDINGS_METHOD=enterprise_base.duties.api.knowledge_spaces
EB_DIFY_API_BASE=http://dify-api:5001/v1
EB_DIFY_DATASET_API_KEY=
EB_DIFY_INDEXING_TECHNIQUE=high_quality
EB_SCOPE_METADATA_FIELD=eb_scope
EB_SOURCE_METADATA_FIELD=eb_source
EB_HASH_METADATA_FIELD=eb_hash
EB_RETRY_ATTEMPTS=5
EB_RETRY_BASE_SECONDS=2
EB_RECONCILE_INTERVAL_SECONDS=3600
