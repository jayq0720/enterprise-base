# X3 按岗位检索服务配置。真实值放服务器密钥文件，不进仓库。
EB_KB_SERVICE_TOKEN=
EB_FRAPPE_URL=http://frappe:8000
EB_FRAPPE_API_KEY=
EB_FRAPPE_API_SECRET=
EB_FRAPPE_WECOM_FIELD=wecom_userid
EB_FRAPPE_SPACES_METHOD=enterprise_base.duties.api.knowledge_spaces
EB_DIFY_API_BASE=http://dify-api:5001/v1
EB_DIFY_DATASET_API_KEY=
EB_SCOPE_METADATA_FIELD=eb_scope
EB_TOP_K_MAX=10
# 每个员工每分钟最多检索几次（0 表示不限），超了返回 429
EB_RATE_PER_MINUTE=30
EB_DIFY_SEARCH_METHOD=hybrid_search
