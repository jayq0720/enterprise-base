# X6 员工前台配置。真实值放服务器密钥文件，不进仓库。
# 员工打开的地址，只写协议和域名（https）
EB_PORTAL_PUBLIC_URL=https://portal.example.com
# 会话 Cookie 签名密钥（≥32 位），只有本服务知道
EB_PORTAL_SESSION_SECRET=
EB_PORTAL_SESSION_TTL_SECONDS=28800
# 隔多久回 X4 重新确认一次在职（秒）；离职、停用后最迟这么久失效
EB_PORTAL_RECHECK_SECONDS=60
# 企业微信自建应用（可以和 X2 扫码登录用同一个），应用的可信域名要加上前台域名
EB_PORTAL_WECOM_CORP_ID=
EB_PORTAL_WECOM_AGENT_ID=
EB_PORTAL_WECOM_APP_SECRET=
# X4 前台接口：地址和 X4 的 EB_MCP_PORTAL_TOKEN
EB_PORTAL_X4_URL=http://frappe-mcp:8080
EB_PORTAL_X4_PORTAL_TOKEN=
# X3：地址和 X3 的 EB_KB_SERVICE_TOKEN
EB_PORTAL_X3_URL=http://kb-gateway:8080
EB_PORTAL_X3_TOKEN=
# Dify 应用 API（Dify 后台“访问 API”里的 Key）；留空的应用不在前台显示
EB_PORTAL_DIFY_API_BASE=http://dify/v1
EB_PORTAL_DIFY_HR_APP_KEY=
EB_PORTAL_DIFY_POLICY_APP_KEY=
# 询盘助手（营销）应用的 API Key，留空不显示
EB_PORTAL_DIFY_MARKETING_APP_KEY=
