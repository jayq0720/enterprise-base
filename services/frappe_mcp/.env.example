# X4 员工 HR 查询服务（frappe_mcp）配置。真实值放服务器密钥文件，不进仓库。
# Dify 调本服务用的服务间 Token（≥32 位），所有接口都要带，/healthz 除外
EB_MCP_SERVICE_TOKEN=
# 签发会话令牌的密钥（≥32 位），只有本服务知道，不要和上面的 Token 相同
EB_MCP_SESSION_SECRET=
# 员工前台（X6）调 /v1/portal/* 的 Token（≥32 位），和上面两项都不同；不用前台就留空，前台接口一律 401
EB_MCP_PORTAL_TOKEN=
EB_SESSION_TTL_SECONDS=900
# 请假草稿多久内可以确认（秒）
EB_DRAFT_TTL_SECONDS=600
EB_FRAPPE_URL=http://frappe:8000
EB_FRAPPE_API_KEY=
EB_FRAPPE_API_SECRET=
EB_FRAPPE_WECOM_FIELD=wecom_userid
# Dify 访问本服务时用的 Host，不在列表里的返回 421（防 DNS 重绑定）
EB_MCP_ALLOWED_HOSTS=["frappe-mcp:8080","localhost:*","127.0.0.1:*"]
EB_LIST_LIMIT=10
