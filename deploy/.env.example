# 复制由 make init 完成；真实值只放 secrets/.env；值用单行，不写引号或变量展开。
EB_PROJECT=eb
# 备份只保存 age 公钥；解密私钥由 JQ 另存。已有环境需手动补这四项。
EB_BACKUP_RECIPIENT=
EB_BACKUP_DIR=data/backups
EB_BACKUP_DAILY=7
EB_BACKUP_WEEKLY=4
EB_DOMAIN=localhost
EB_SCHEME=http
EB_BIND=127.0.0.1
# 管理员固定出口 IP/CIDR，多个条目用空格分隔；禁止全网范围。
EB_ADMIN_ALLOW_CIDRS=127.0.0.1/32
# 默认聊天直连；审批相关 PR 全部合并并验证后才改 approvals（仅 HTTPS）。
EB_WECOM_CALLBACK_MODE=bridge
EB_FRAPPE_DB_PASSWORD=CHANGE_ME
EB_FRAPPE_ADMIN_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
SANDBOX_API_KEY=CHANGE_ME
PLUGIN_DAEMON_KEY=CHANGE_ME
PLUGIN_DIFY_INNER_API_KEY=CHANGE_ME
QDRANT_API_KEY=CHANGE_ME
DIFY_AGENT_API_TOKEN=CHANGE_ME
DIFY_AGENT_SERVER_SECRET_KEY=CHANGE_ME
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=CHANGE_ME
# Dify 创建 Chatflow 后，在服务器填写；make wechat 前必须全部填写。
DIFY_API_KEY=
WECHATCOM_CORP_ID=
WECHATCOMAPP_SECRET=
WECHATCOMAPP_AGENT_ID=
WECHATCOMAPP_TOKEN=
WECHATCOMAPP_AES_KEY=
# X5：前两项由 make init 生成；其余凭据由管理员在后台生成并录入。
EB_SYNC_WEBHOOK_SECRET=CHANGE_ME
EB_SYNC_SERVICE_TOKEN=CHANGE_ME
EB_SYNC_FRAPPE_API_KEY=
EB_SYNC_FRAPPE_API_SECRET=
EB_SYNC_DIFY_DATASET_API_KEY=
EB_SYNC_DIFY_INDEXING_TECHNIQUE=high_quality
# 来自本仓库 CI 的固定发布摘要。
EB_POLICY_SYNC_IMAGE=ghcr.io/jayq0720/enterprise-base-policy-sync@sha256:a58c658531701ad4d38deb7b5c6d46e3e36bcf059a0af73159ee7b47b8ef5dae
# X3/X4：前三项由 make init 独立生成；API 凭据由管理员录入。
EB_KB_SERVICE_TOKEN=CHANGE_ME
EB_MCP_SERVICE_TOKEN=CHANGE_ME
EB_MCP_SESSION_SECRET=CHANGE_ME
# X3 使用 eb-x3@integration.invalid；X4 必须使用 eb-x4@integration.invalid。
EB_KB_FRAPPE_API_KEY=
EB_KB_FRAPPE_API_SECRET=
EB_KB_DIFY_DATASET_API_KEY=
EB_MCP_FRAPPE_API_KEY=
EB_MCP_FRAPPE_API_SECRET=
# 与 X5 知识库索引匹配：high_quality 用 hybrid_search；economy 用 keyword_search。
EB_KB_DIFY_SEARCH_METHOD=hybrid_search
# main 1f13089，Actions 38879664692 的产物；不得用 PR 构建或浮动标签。
EB_KB_GATEWAY_IMAGE=ghcr.io/jayq0720/enterprise-base-kb-gateway@sha256:911fb219c9eb592f4f66ee299d2f17fa615e337bf65d26112feb3535f5075fa6
# X4 main bb82cca，Actions 39188132593：含岗位开关和缺岗位/缺值拒绝。
EB_FRAPPE_MCP_IMAGE=ghcr.io/jayq0720/enterprise-base-frappe-mcp@sha256:3df319517ed6a6cdd531ab2d909c9b083e86e11fe87fef9e50ad14a1ff6c1bea
# 员工前台 X6：两项密钥由 make init 独立生成；企业微信应用（可与扫码登录同一个）由管理员录入。
# Dify 两个应用的 API Key 留空时，前台不显示对应对话。
EB_PORTAL_SESSION_SECRET=CHANGE_ME
EB_MCP_PORTAL_TOKEN=CHANGE_ME
EB_PORTAL_WECOM_CORP_ID=
EB_PORTAL_WECOM_AGENT_ID=
EB_PORTAL_WECOM_APP_SECRET=
EB_PORTAL_DIFY_HR_APP_KEY=
EB_PORTAL_DIFY_POLICY_APP_KEY=
# 询盘助手（营销）应用的 API Key，留空不显示
EB_PORTAL_DIFY_MARKETING_APP_KEY=
# 询盘进件 Token：make init 独立生成；网站表单后台推询盘到 portal.<域名>/inquiry/intake 时带
# Authorization: Bearer <它>。只给网站后台，不要放进网页前端代码。
EB_MCP_INTAKE_TOKEN=CHANGE_ME
# main CI 发布的固定摘要。
EB_PORTAL_IMAGE=ghcr.io/jayq0720/enterprise-base-portal@sha256:55c19f73cd2ea89bb66f93c7d947cc735c3dc160e3776df2f9cf7612f2777271

# 监控：真实群机器人Webhook仅放服务器私有文件；留空只写本机日志。
EB_ALERT_WECOM_WEBHOOK=
# 额外检查整个可选服务缺失；按已启用功能填 wechat,policy-sync,hr-assistant。
EB_HEALTH_PROFILES=
EB_HEALTH_DISK_MIN_PERCENT=15
EB_HEALTH_MEMORY_MIN_PERCENT=10
EB_HEALTH_BACKUP_MAX_HOURS=26
EB_HEALTH_QUEUE_MAX=100
EB_HEALTH_CERT_MIN_DAYS=14
EB_HEALTH_HTTP_TIMEOUT=10
