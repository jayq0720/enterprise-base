(admin_only) {
    @denied not remote_ip {$EB_ADMIN_ALLOW_CIDRS:127.0.0.1/32}
    respond @denied 403
}
{$DIFY_ADDRESS} {
    route {
        import admin_only
        reverse_proxy dify:80
    }
}
{$HR_ADDRESS} {
    route {
        import admin_only
        reverse_proxy frappe:8080
    }
}
{$WECOM_ADDRESS} {
    handle /wxcomapp {
        reverse_proxy wechat:9898
    }
    respond 404
}
# 员工前台（X6）对员工开放，不加管理员白名单；身份由前台扫码登录校验。
{$PORTAL_ADDRESS} {
    request_body {
        max_size 65536
    }
    reverse_proxy portal:8080
}
