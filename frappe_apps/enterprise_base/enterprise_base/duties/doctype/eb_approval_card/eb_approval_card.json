{
  "doctype": "DocType",
  "name": "EB Approval Card",
  "module": "Duties",
  "custom": 0,
  "istable": 0,
  "engine": "InnoDB",
  "autoname": "field:task_id",
  "field_order": ["task_id", "leave_application", "stage", "recipient", "userid", "status", "result", "handled_by", "response_code", "sent_at", "attempts"],
  "fields": [
    {"fieldname": "task_id", "label": "任务 ID", "fieldtype": "Data", "reqd": 1, "unique": 1, "read_only": 1},
    {"fieldname": "leave_application", "label": "请假单", "fieldtype": "Link", "options": "Leave Application", "reqd": 1, "read_only": 1},
    {"fieldname": "stage", "label": "审批阶段", "fieldtype": "Data", "reqd": 1, "read_only": 1},
    {"fieldname": "recipient", "label": "审批用户", "fieldtype": "Link", "options": "User", "reqd": 1, "read_only": 1},
    {"fieldname": "userid", "label": "企业微信 userid", "fieldtype": "Data", "reqd": 1, "read_only": 1},
    {"fieldname": "status", "label": "处理状态", "fieldtype": "Select", "options": "Pending\nSent\nDone\nFailed\nExpired", "default": "Pending", "reqd": 1, "read_only": 1},
    {"fieldname": "result", "label": "结果", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "handled_by", "label": "处理人", "fieldtype": "Link", "options": "User", "read_only": 1},
    {"fieldname": "response_code", "label": "卡片更新凭证", "fieldtype": "Password", "read_only": 1, "hidden": 1},
    {"fieldname": "sent_at", "label": "发送时间", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "attempts", "label": "尝试次数", "fieldtype": "Int", "default": "0", "read_only": 1}
  ],
  "permissions": [{"role": "System Manager", "read": 1}],
  "track_changes": 0,
  "allow_rename": 0
}
