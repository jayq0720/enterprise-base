{
  "schema": {
    "doctype": "DocType",
    "name": "EB Approval Card",
    "module": "Duties",
    "custom": 1,
    "istable": 0,
    "engine": "InnoDB",
    "autoname": "field:task_id",
    "field_order": [
      "task_id",
      "leave_application",
      "stage",
      "recipient",
      "userid",
      "status",
      "result",
      "handled_by",
      "response_code",
      "sent_at",
      "attempts",
      "update_status"
    ],
    "fields": [
      {
        "fieldname": "task_id",
        "label": "任务 ID",
        "fieldtype": "Data",
        "reqd": 1,
        "unique": 1,
        "read_only": 1
      },
      {
        "fieldname": "leave_application",
        "label": "请假单",
        "fieldtype": "Link",
        "options": "Leave Application",
        "reqd": 1,
        "read_only": 1
      },
      {
        "fieldname": "stage",
        "label": "审批阶段",
        "fieldtype": "Data",
        "reqd": 1,
        "read_only": 1
      },
      {
        "fieldname": "recipient",
        "label": "审批用户",
        "fieldtype": "Link",
        "options": "User",
        "reqd": 1,
        "read_only": 1
      },
      {
        "fieldname": "userid",
        "label": "企业微信 userid",
        "fieldtype": "Data",
        "reqd": 1,
        "read_only": 1
      },
      {
        "fieldname": "status",
        "label": "处理状态",
        "fieldtype": "Select",
        "options": "Pending\nSent\nDone\nFailed\nExpired",
        "default": "Pending",
        "reqd": 1,
        "read_only": 1
      },
      {
        "fieldname": "result",
        "label": "结果",
        "fieldtype": "Data",
        "read_only": 1
      },
      {
        "fieldname": "handled_by",
        "label": "处理人",
        "fieldtype": "Link",
        "options": "User",
        "read_only": 1
      },
      {
        "fieldname": "response_code",
        "label": "卡片更新凭证",
        "fieldtype": "Password",
        "read_only": 1,
        "hidden": 1
      },
      {
        "fieldname": "sent_at",
        "label": "发送时间（UTC）",
        "fieldtype": "Data",
        "read_only": 1
      },
      {
        "fieldname": "attempts",
        "label": "尝试次数",
        "fieldtype": "Int",
        "default": "0",
        "read_only": 1
      },
      {
        "fieldname": "update_status",
        "label": "更新状态",
        "fieldtype": "Select",
        "options": "Pending\nDone\nFailed\nExpired",
        "default": "Pending",
        "read_only": 1
      }
    ],
    "permissions": [
      {
        "role": "System Manager",
        "read": 1
      }
    ],
    "track_changes": 0,
    "allow_rename": 0
  },
  "flow": {
    "doctype": "Workflow",
    "name": "EB Leave Review",
    "workflow_name": "EB Leave Review",
    "document_type": "Leave Application",
    "is_active": 1,
    "workflow_state_field": "eb_leave_state",
    "send_email_alert": 0,
    "states": [
      {
        "state": "EB Leave Manager",
        "allow_edit": "Employee",
        "doc_status": "0",
        "update_field": "status",
        "update_value": "Open"
      },
      {
        "state": "EB Leave HR",
        "allow_edit": "HR Manager",
        "doc_status": "0",
        "update_field": "status",
        "update_value": "Open"
      },
      {
        "state": "EB Leave Returned",
        "allow_edit": "Employee",
        "doc_status": "0",
        "update_field": "status",
        "update_value": "Open"
      },
      {
        "state": "EB Leave Approved",
        "allow_edit": "HR Manager",
        "doc_status": "1",
        "update_field": "status",
        "update_value": "Approved"
      },
      {
        "state": "EB Leave Rejected",
        "allow_edit": "HR Manager",
        "doc_status": "1",
        "update_field": "status",
        "update_value": "Rejected"
      },
      {
        "state": "EB Leave Cancelled",
        "allow_edit": "HR Manager",
        "doc_status": "2",
        "update_field": "status",
        "update_value": "Cancelled"
      }
    ],
    "transitions": [
      {
        "state": "EB Leave Manager",
        "action": "EB Manager Approve",
        "next_state": "EB Leave HR",
        "allowed": "Leave Approver",
        "condition": "doc.leave_approver == frappe.session.user and frappe.db.get_value(\"Employee\", doc.employee, \"user_id\") != frappe.session.user",
        "allow_self_approval": 0
      },
      {
        "state": "EB Leave Manager",
        "action": "EB Return Leave",
        "next_state": "EB Leave Returned",
        "allowed": "Leave Approver",
        "condition": "doc.leave_approver == frappe.session.user and frappe.db.get_value(\"Employee\", doc.employee, \"user_id\") != frappe.session.user",
        "allow_self_approval": 0
      },
      {
        "state": "EB Leave Manager",
        "action": "EB Reject Leave",
        "next_state": "EB Leave Rejected",
        "allowed": "Leave Approver",
        "condition": "doc.leave_approver == frappe.session.user and frappe.db.get_value(\"Employee\", doc.employee, \"user_id\") != frappe.session.user",
        "allow_self_approval": 0
      },
      {
        "state": "EB Leave HR",
        "action": "EB HR Approve",
        "next_state": "EB Leave Approved",
        "allowed": "HR Manager",
        "condition": "doc.eb_hr_approver == frappe.session.user and frappe.db.get_value(\"Employee\", doc.employee, \"user_id\") != frappe.session.user",
        "allow_self_approval": 0
      },
      {
        "state": "EB Leave HR",
        "action": "EB Return Leave",
        "next_state": "EB Leave Returned",
        "allowed": "HR Manager",
        "condition": "doc.eb_hr_approver == frappe.session.user and frappe.db.get_value(\"Employee\", doc.employee, \"user_id\") != frappe.session.user",
        "allow_self_approval": 0
      },
      {
        "state": "EB Leave HR",
        "action": "EB Reject Leave",
        "next_state": "EB Leave Rejected",
        "allowed": "HR Manager",
        "condition": "doc.eb_hr_approver == frappe.session.user and frappe.db.get_value(\"Employee\", doc.employee, \"user_id\") != frappe.session.user",
        "allow_self_approval": 0
      },
      {
        "state": "EB Leave Returned",
        "action": "EB Resend Leave",
        "next_state": "EB Leave Manager",
        "allowed": "Employee",
        "condition": "frappe.db.get_value(\"Employee\", doc.employee, \"user_id\") == frappe.session.user",
        "allow_self_approval": 1
      },
      {
        "state": "EB Leave Approved",
        "action": "EB Cancel Leave",
        "next_state": "EB Leave Cancelled",
        "allowed": "HR Manager",
        "condition": "doc.eb_hr_approver == frappe.session.user and frappe.db.get_value(\"Employee\", doc.employee, \"user_id\") != frappe.session.user",
        "allow_self_approval": 0
      }
    ]
  },
  "records": [
